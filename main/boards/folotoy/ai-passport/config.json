                "CONFIG_WAKE_WORD_DISABLED=y",
                "CONFIG_PM_ENABLE=y",
                "CONFIG_USE_MULTILINE_CHAT_MESSAGE=y",
                "CONFIG_LV_FONT_MONTSERRAT_48=y",
                "CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n"
            ]
        }
    ]
}
